# 用法：复制成 .env（cp .env.example .env），再按需改下面的值。

# ---- 模型（必填，不填只能用兜底句子）----
OPENAI_API_KEY=sk-xxxxxxxx
# 用 DeepSeek / 通义 / 任何 OpenAI 兼容接口时填这个：
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# ---- 协议端（NapCat 正向 WebSocket）----
ONEBOT_WS=ws://127.0.0.1:3001
# NapCat 里给 OneBot WebSocket 设置的 token，留空表示不校验
ONEBOT_TOKEN=

# ---- 它叫什么（叫到这些词或 @ 它才回）----
BOT_NAMES=肥鱼,大肥鱼

# ---- 同一个群最短间隔（秒），防止刷屏 ----
COOLDOWN=3

# ---- 工具：查天气、搜东西、查梗、发表情包 ----
# 1=开，0=关。开了之后它遇到不懂的会自己去查。
USE_TOOLS=1

# ---- 自主插话（风险最高，默认关）----
# 每条群消息它自己决定插话的几率，0=完全不插
AUTO_CHANCE=0
# 同一个群两次插话最短间隔（秒）
AUTO_COOLDOWN=600
# 每小时最多插几次
AUTO_MAX_PER_HOUR=3
