# 用法：复制成 .env（cp .env.example .env），再按需改下面的值。

# ---- 模型（必填，不填只能用兜底句子）----
OPENAI_API_KEY=sk-xxxxxxxx
# 用 DeepSeek / 通义 / 任何 OpenAI 兼容接口时填这个：
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# ---- 协议端（NapCat 正向 WebSocket）----
ONEBOT_WS=ws://127.0.0.1:3001
# NapCat 里给 OneBot WebSocket 设置的 token，留空表示不校验
ONEBOT_TOKEN=

# ---- 它叫什么（叫到这些词或 @ 它才回）----
BOT_NAMES=肥鱼,大肥鱼

# ---- 同一个群最短间隔（秒），防止刷屏 ----
COOLDOWN=3

# ---- 工具：查天气、搜东西、查梗、发表情包 ----
# 1=开，0=关。开了之后它遇到不懂的会自己去查。
USE_TOOLS=1

# ---- 表情包存档 ----
# 1=每发一张也存进 QQ 收藏表情，0=不存
MEME_SAVE=1

# ---- 水群模式：像真人一样跟着聊，不需要 @ ----
# 每条消息被考虑接话的几率，0=完全不接
AUTO_CHANCE=1.0
# 两次接话最短间隔（秒）
AUTO_COOLDOWN=15
# 每小时最多接几次
AUTO_MAX_PER_HOUR=80
# 群里多久内有消息才算"在聊"
AUTO_ALIVE_WINDOW=600
AUTO_ALIVE_MIN=1
